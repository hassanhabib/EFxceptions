<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net10.0</TargetFrameworks>
		<ImplicitUsings>disable</ImplicitUsings>
		<Nullable>disable</Nullable>
		<Version>10.0.0</Version>
		<AssemblyVersion>10.0.0.0</AssemblyVersion>
		<FileVersion>10.0.0.0</FileVersion>
		<Description>
			EFxceptions.Identity.Core provides the core abstractions for converting ASP.NET Core
			Identity Entity Framework exceptions into meaningful, domain-friendly exceptions.
			This package specifically targets Microsoft.EntityFrameworkCore 10.0.7.
		</Description>
		<Copyright>Copyright (c) The Standard Community</Copyright>
		<Authors>Hassan Habib</Authors>
		<Company>The Standard Community</Company>
		<NeutralLanguage>en</NeutralLanguage>
		<PackageProjectUrl>https://github.com/hassanhabib/EFxceptions</PackageProjectUrl>
		<RepositoryUrl>https://github.com/hassanhabib/EFxceptions</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageTags>Exceptions EntityFramework EFCore Identity AspNetCore</PackageTags>
		<PackageReleaseNotes>Configure and select history table</PackageReleaseNotes>
		<PackageIcon>EFxceptions.png</PackageIcon>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseFile>License.txt</PackageLicenseFile>
		<PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.7" />
		<PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.7" />
	</ItemGroup>

	<Import Project="..\EFxceptions.Shared\EFxceptions.Shared.projitems" Label="Shared" />

	<ItemGroup>
		<None Include="..\README.md">
			<Pack>true</Pack>
			<PackagePath></PackagePath>
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
	</ItemGroup>

	<ItemGroup>
		<None Include="..\EFxceptions.Shared\License.txt" Pack="true" PackagePath="" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\EFxceptions.Shared\Resources\EFxceptions.png" Pack="true" PackagePath="" />
	</ItemGroup>

</Project>
