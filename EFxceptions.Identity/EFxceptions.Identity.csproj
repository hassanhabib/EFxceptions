<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <Version>10.0.0</Version>
    <AssemblyVersion>10.0.0.0</AssemblyVersion>
    <FileVersion>10.0.0.0</FileVersion>
    <Description>
      EFxceptions.Identity captures exceptions thrown by ASP.NET Core Identity with Entity Framework
      from a SQL Server database and converts them into meaningful, domain-friendly exceptions.
      This package specifically targets Microsoft.EntityFrameworkCore 10.0.7.
    </Description>
    <Copyright>Copyright (c) The Standard Community</Copyright>
    <Authors>Hassan Habib</Authors>
    <Company>The Standard Community</Company>
    <NeutralLanguage>en</NeutralLanguage>
    <PackageProjectUrl>https://github.com/hassanhabib/EFxceptions</PackageProjectUrl>
    <RepositoryUrl>https://github.com/hassanhabib/EFxceptions</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>Exceptions EntityFramework EFCore Identity AspNetCore SqlServer</PackageTags>
    <PackageReleaseNotes>Use latest NuGet dependencies</PackageReleaseNotes>
    <PackageIcon>EFxceptions.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseFile>License.txt</PackageLicenseFile>
    <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.7" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.7" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\README.md">
      <Pack>true</Pack>
      <PackagePath></PackagePath>
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <None Include="..\EFxceptions.Shared\License.txt" Pack="true" PackagePath="" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\EFxceptions.Shared\Resources\EFxceptions.png" Pack="true" PackagePath="" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EFxceptions.Identity.Core\EFxceptions.Identity.Core.csproj" />
  </ItemGroup>
</Project>
